<script>
    const modal = document.getElementById('avicii-modal');
    const openBtn = document.getElementById('open-avicii');
    const closeBtn = document.getElementById('close-avicii');
    const video = document.getElementById('avicii-video');

    openBtn.addEventListener('click', (e) => {
        e.preventDefault();

        modal.classList.add('open');

        /* lås scrolling i bakgrunnen */
        document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', closeModal);

    modal.querySelector('.avicii-backdrop')
        .addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeModal();
        }
    });

    function closeModal() {
        modal.classList.remove('open');

        /* gjenopprett scrolling */
        document.body.style.overflow = '';

        video.pause();
        video.currentTime = 0;
    }
</script>

