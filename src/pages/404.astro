---
import Ticker from "../components/Ticker.astro";
import Instagram from "../components/Instagram.astro";
import Hero from "../components/Hero.astro";
---
<html lang="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>404 | Helsereis</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
<Ticker />
<Instagram />
<section class="section error404">

  <div class="wrap">

    <div class="kicker">
      [404] Navigasjonssvikt
    </div>

    <h1>
      Du har kjørt feil.
    </h1>

    <p>
      Dette er ikke nødvendigvis alvorlig.
      Mange av de beste omveiene begynner slik.
    </p>

    <p>
      Dessverre førte denne omveien ikke til et bakeri,
      en kaffe eller en utsikt verdt å stoppe for.
    </p>

    <p>
      Administrasjonen anbefaler derfor kontrollert retur
      til kjent terreng.
    </p>

    <a href="https://helsereis.no" class="interest-button">
 Tilbake til feltet ↗
    </a>

  </div>

</section>

</body>
</html>