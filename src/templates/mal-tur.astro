---
import Ticker from "../../../components/Ticker.astro";
import Instagram from "../../../components/Instagram.astro";
import Footer from "../../../components/Footer.astro";
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Turmål årstall | Helsereis</title>

    <meta
      name="description"
      content="Historier, bilder, ruter og høydepunkter fra tur x."
    />

    <link rel="canonical" href="https://helsereis.no">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    </head>
 <body>   
    <Ticker />
    <Instagram />

    <main>

    <section
  class="trip-hero"
  style="background-image:url('/images/turer/2026-costa-blanca/hero.webp');"
>
<div class="trip-hero-overlay"></div>
<div class="wrap hero-content">
        <div class="hero-quote">
          <span class="eyebrow">
          Feltrapport 2026
          </span>
        </div>

      <h1>
      Turmål årstall
      <span style="font-size:0.8em;">
        årstall - rapport
      </span>
      </h1>
   
      
    </div>

</section>

<section class="section">
  <div class="wrap">

    <div class="kicker">
      [01] Feltnotater
    </div>
    <h2>Introduksjon</h2>
    </div>
  </section>

  <section class="section">

  <div class="wrap">

    <div class="kicker">
      [SLUTT PÅ RAPPORT]
    </div>

    <h2>
      Kontrollert retur.
    </h2>

    <p>
      Rapporten er avsluttet, men administrasjonen
      vurderer allerede neste omvei.
    </p>

    <div class="report-links">

      <a href="/turer/">
        ← Tilbake til turarkivet
      </a> 
       
      <a href="/">
        Tilbake til administrasjonen →
      </a>

    </div>

  </div>

</section>

    </main>

    <Footer />
  </body>
</html>